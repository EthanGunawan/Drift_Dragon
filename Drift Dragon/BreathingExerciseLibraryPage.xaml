<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Drift_Dragon.BreathingExerciseLibraryPage"
             Title="Breathing Exercises">

    <Grid RowDefinitions="Auto,*,Auto" Padding="25">
        
        <!-- Header -->
        <Label Grid.Row="0"
               Text="🫁 Breathing Exercises"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,30"/>

        <!-- Swipeable, scrollable cards -->
        <CarouselView Grid.Row="1" 
                      x:Name="ExercisesCarousel"
                      Loop="False"
                      Margin="10">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White"
                           CornerRadius="20"
                           HasShadow="True"
                           Padding="20"
                           Margin="10">
                        <!-- Make card content scrollable -->
                        <ScrollView>
                            <VerticalStackLayout Spacing="15">
                                <!-- Exercise Name -->
                                <Label Text="{Binding Name}" 
                                       FontSize="24" 
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="#2C3E50"/>
                                
                                <!-- Description -->
                                <Label Text="{Binding Description}" 
                                       FontSize="16" 
                                       HorizontalOptions="Center"
                                       TextColor="#7F8C8D"
                                       LineBreakMode="WordWrap"
                                       Margin="0,0,0,10"/>
                                
                                <!-- Instructions Box -->
                                <Border BackgroundColor="#F8F9FA"
                                        Stroke="#E9ECEF"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="15"
                                        Margin="0,10,0,15">
                                    <Label Text="{Binding Instructions}" 
                                           FontSize="14"
                                           LineBreakMode="WordWrap"
                                           TextColor="#34495E"
                                           HorizontalOptions="Fill"/>
                                </Border>
                                
                                <!-- START BUTTON -->
                                <Button Text="🫁 START BREATHING"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HeightRequest="55"
                                        CornerRadius="25"
                                        Clicked="OnStartExercise"
                                        HorizontalOptions="Fill"/>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Frame>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Progress Indicator -->
        <Label Grid.Row="2"
               x:Name="PositionLabel"
               Text="Swipe to explore →"
               FontSize="16"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#4A90E2"
               Margin="0,20"/>

    </Grid>
</ContentPage>
