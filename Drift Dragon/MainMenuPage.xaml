<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Drift_Dragon.MainMenuPage"
             Title="Drift Dragon">

    <Grid RowDefinitions="*,Auto" Padding="25">
        
        <!-- Rotating Tip Card WITH DRAGON LOGO -->
        <Frame Grid.Row="0" 
               x:Name="TipFrame"
               BackgroundColor="#E8F4FD" 
               CornerRadius="20" 
               HasShadow="True"
               Padding="25"
               Margin="20">
            <VerticalStackLayout Spacing="20">
                
                <!-- DRIFT DRAGON LOGO -->
                <Image Source="drift_dragon.jpg"
                       HeightRequest="120"
                       WidthRequest="120"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <!-- TIP CONTENT + STAR (FIXED LAYOUT) -->
                <Grid RowDefinitions="*,Auto" Margin="0,0,0,10">
                    <!-- Tip Text -->
                    <Label x:Name="TipLabel" 
                           Grid.Row="0"
                           Text="Loading tips..." 
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           MaxLines="4"/>
                    
                    <!-- Star Button - Bottom Right Corner -->
                    <Button x:Name="StarButton" 
                            Grid.Row="1"
                            Text="⭐" 
                            BackgroundColor="Transparent"
                            TextColor="Gold"
                            FontSize="28"
                            Clicked="OnStarClicked"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,5,5,5"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>
        
        <!-- NAVIGATION BUTTONS -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">
                <Button Text="🫁 Breathing Exercises" 
                        Clicked="OnBreathingClicked"
                        BackgroundColor="#4A90E2"
                        TextColor="White"
                        HeightRequest="65"
                        FontSize="18"
                        CornerRadius="30"
                        HorizontalOptions="Fill"/>
                        
                <Button Text="📝 Mood Journal" 
                        Clicked="OnMoodJournalClicked"
                        BackgroundColor="#7ED321"
                        TextColor="White"
                        HeightRequest="65"
                        FontSize="18"
                        CornerRadius="30"
                        HorizontalOptions="Fill"/>
                        
                <Button Text="📊 Progress Dashboard" 
                        Clicked="OnDashboardClicked"
                        BackgroundColor="#F5A623"
                        TextColor="White"
                        HeightRequest="65"
                        FontSize="18"
                        CornerRadius="30"
                        HorizontalOptions="Fill"/>
                        
                <Button Text="🎵 Relaxing Listening" 
                        Clicked="OnListeningClicked"
                        BackgroundColor="#D0021B"
                        TextColor="White"
                        HeightRequest="65"
                        FontSize="18"
                        CornerRadius="30"
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
