<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Drift_Dragon.RelaxingListeningPage"
             Title="🎵 Relaxing Listening">

    <Grid RowDefinitions="Auto,*" Padding="25">
        
        <!-- Header -->
        <Label Grid.Row="0"
               Text="🎵 Relaxing Listening"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,30"/>

        <!-- Audio Cards -->
        <CollectionView Grid.Row="1" 
                        x:Name="AudioCollectionView"
                        RemainingItemsThreshold="3">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="5">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="▶️ Play"
                                           BackgroundColor="#27AE60"
                                           Invoked="OnPlayTrack"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Stroke="#E9ECEF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="White"
                                Padding="20"
                                Margin="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Audio Info WITH LOGO -->
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Image Source="drift_dragon.jpg"
                                           HeightRequest="50"
                                           WidthRequest="50"
                                           HorizontalOptions="Center"
                                           Margin="0,0,0,8"/>

                                    <Label Text="{Binding Title}" 
                                           FontSize="20" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="{Binding Category}" 
                                           FontSize="14"
                                           TextColor="#4A90E2"
                                           FontAttributes="Italic"/>
                                    <Label Text="{Binding Duration}" 
                                           FontSize="12"
                                           TextColor="#95A5A6"/>
                                </VerticalStackLayout>
                                
                                <!-- Play Button -->
                                <Button Grid.Column="1"
                                        Text="▶️"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"
                                        FontSize="24"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        CornerRadius="30"
                                        Clicked="OnPlayTrack"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
