<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Drift_Dragon.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Drift_Dragon">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainMenuPage}"
        Route="MainMenuPage" />
    <!-- Add to AppShell.xaml -->
    <ShellContent
        Title="Breathing Exercises"
        ContentTemplate="{DataTemplate local:BreathingExerciseLibraryPage}"
        Route="BreathingExercisesPage" />
    <ShellContent
        Title="Relaxing Listening"
        ContentTemplate="{DataTemplate local:RelaxingListeningPage}"
        Route="RelaxingListeningPage" />


</Shell>